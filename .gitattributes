# Anything that runs on the server MUST have LF endings. A CRLF shebang line fails
# on Linux with the singularly unhelpful "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile*  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.example   text eol=lf

# PowerShell runs on Windows; CRLF is fine and expected there.
*.ps1       text eol=crlf
