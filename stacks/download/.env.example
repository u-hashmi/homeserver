# copy to .env

TZ=America/New_York
BULK=/mnt/bulk
PUID=1000
PGID=1000
EDGE_SUBNET=172.28.0.0/16
LAN_SUBNET=192.168.1.0/24

# ---- commercial VPN for the download traffic --------------------------------
# OUTBOUND, and completely separate from the wg-easy server you dial into.

VPN_SERVICE_PROVIDER=private internet access

# PIA authenticates against its own API, so these are your *PIA credentials* --
# NOT your pia.com website login. Generate them at:
#   PIA account -> Account -> "PIA Credentials" / OpenVPN & PPTP config
# The username looks like p1234567.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Port forwarding is mandatory for usable torrents, and NOT every PIA region
# supports it -- notably none of the US ones. PORT_FORWARD_ONLY=on (set in the
# compose file) makes gluetun refuse any server that cannot forward, so a bad
# region here fails loudly instead of silently crippling downloads.
# Known-good: CA Montreal, CA Toronto, Netherlands, Switzerland, Romania, Germany.
SERVER_REGIONS=CA Montreal
VPN_PORT_FORWARDING=on

# ---- other providers, for reference -----------------------------------------
# ProtonVPN / Mullvad / AirVPN use a WireGuard key instead of account credentials:
#   VPN_SERVICE_PROVIDER=protonvpn
#   WIREGUARD_PRIVATE_KEY=
#   WIREGUARD_ADDRESSES=10.2.0.2/32
#   SERVER_COUNTRIES=Netherlands
