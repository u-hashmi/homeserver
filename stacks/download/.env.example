# copy to .env

TZ=America/New_York
BULK=/mnt/bulk
PUID=1000
PGID=1000
EDGE_SUBNET=172.28.0.0/16
LAN_SUBNET=192.168.1.0/24

# --- commercial VPN for the download traffic ----------------------------------
# This is OUTBOUND and completely separate from the wg-easy server you dial into.
#
# Pick a provider that still does port forwarding, or torrents will be
# upload-crippled. As of now that means ProtonVPN (NAT-PMP) or AirVPN — Mullvad
# dropped it. gluetun supports both natively.
#
# ProtonVPN: account -> WireGuard configuration -> create a key with NAT-PMP
# (port forwarding) enabled, then copy the PrivateKey line out of the .conf.
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
SERVER_COUNTRIES=Netherlands
VPN_PORT_FORWARDING=on
