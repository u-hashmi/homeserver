# copy to .env

TZ=America/New_York

# ---- why there are TWO DuckDNS domains --------------------------------------
# DuckDNS points a domain at exactly one IP, but this build needs two:
#
#   hashsrv.duckdns.org  -> 192.168.1.198   the server's PRIVATE LAN IP.
#                           Every service hostname lives under it. Resolves
#                           publicly to an unroutable address, which is what
#                           lets Caddy hold a real wildcard cert with nothing
#                           exposed. Set this ONCE by hand (see docs/05).
#
#   hashvpn.duckdns.org  -> your PUBLIC IP. The WireGuard endpoint clients dial.
#                           ddns-updater keeps this current as your ISP rotates it.
#
# A free DuckDNS account allows up to 5 domains, so this costs nothing.

# The WireGuard endpoint clients dial.
WG_HOST=hashvpn.duckdns.org

# Your LAN, for the split-tunnel route pushed to clients. This is also what makes
# hashsrv.duckdns.org reachable over the tunnel.
LAN_SUBNET=192.168.1.0/24

# DNS handed to clients. A public resolver is correct here: the service names
# resolve publicly to the private LAN IP, and the tunnel routes that subnet.
WG_CLIENT_DNS=1.1.1.1

# Login for the wg-easy UI. Generate the bcrypt hash and DOUBLE every $ in it
# (docker compose eats single ones):
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YOUR_PASSWORD'
WG_UI_PASSWORD_HASH=
