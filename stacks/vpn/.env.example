# copy to .env

TZ=America/New_York

# The hostname your WireGuard clients dial. Must resolve to your PUBLIC ip —
# ddns-updater keeps it accurate. (Distinct from the LAN-IP service records.)
WG_HOST=vpn.home.example.com

# Your LAN, for the split-tunnel route pushed to clients.
LAN_SUBNET=192.168.1.0/24

# DNS handed to clients. Public resolver is right for the DNS-01/real-cert setup,
# because *.home.example.com resolves publicly to your private LAN IP.
WG_CLIENT_DNS=1.1.1.1

# Login for the wg-easy UI. Generate the bcrypt hash and DOUBLE every $ in it
# (docker compose eats single $):
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YOUR_PASSWORD'
WG_UI_PASSWORD_HASH=
