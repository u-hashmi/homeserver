# copy to .env

DOMAIN=home.example.com
BULK=/mnt/bulk
EDGE_SUBNET=172.28.0.0/16

# Pin the major. Nextcloud refuses to skip majors on upgrade — bump ONE at a time
# (31 -> 32 -> 33), checking https://hub.docker.com/_/nextcloud for current stable.
NEXTCLOUD_TAG=31-apache
POSTGRES_TAG=17-alpine

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_long_random

NEXTCLOUD_ADMIN_USER=hash
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_long_random

# Optional: outbound mail for share notifications / password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_NAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_DOMAIN=
