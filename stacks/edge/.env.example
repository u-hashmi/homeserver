# copy to .env

# Your domain. Every service is a subdomain of it (nextcloud.<DOMAIN>, plex..., etc).
DOMAIN=home.example.com

# Which Caddyfile to mount: Caddyfile (Cloudflare DNS-01) or Caddyfile.internal
CADDYFILE=Caddyfile

# --- only needed for CADDYFILE=Caddyfile ---------------------------------------
ACME_EMAIL=you@example.com
# Cloudflare API token, scoped to: Zone / DNS / Edit  on this zone ONLY.
# Create at https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# The server's LAN IP. Point your wildcard A record at this:
#   *.home.example.com  A  192.168.1.50   (DNS only — grey cloud, NOT proxied)
LAN_IP=192.168.1.50
