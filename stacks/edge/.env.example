# copy to .env

# ---- which TLS mode ----------------------------------------------------------
# Caddyfile           Cloudflare DNS-01, per-subdomain certs. Needs a domain on CF.
# Caddyfile.duckdns   DuckDNS DNS-01, ONE wildcard cert. Free, no domain purchase.
# Caddyfile.internal  Caddy's own CA. No DNS at all; install its root cert per device.
CADDYFILE=Caddyfile.duckdns

# Your SERVICES domain. Every web UI is a subdomain of it.
# For DuckDNS this is the domain you pointed at the server's PRIVATE LAN IP.
DOMAIN=hashsrv.duckdns.org

ACME_EMAIL=hash.design.develop@gmail.com

# ---- DuckDNS (CADDYFILE=Caddyfile.duckdns) ----------------------------------
# One token per account, shown at https://www.duckdns.org after signing in.
# The SAME token covers every domain on the account.
DUCKDNS_TOKEN=

# ---- Cloudflare (CADDYFILE=Caddyfile) ---------------------------------------
# API token scoped to Zone / DNS / Edit on that zone only.
CF_DNS_API_TOKEN=

# The server's LAN IP. Your services domain must resolve here.
LAN_IP=192.168.1.198
