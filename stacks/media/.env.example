# copy to .env

TZ=America/New_York
BULK=/mnt/bulk
PUID=1000
PGID=1000

# Grab a fresh token from https://plex.tv/claim (valid 4 minutes) for the FIRST
# start only — it links the server to your Plex account without the setup wizard
# needing to reach you from outside. Blank it out afterwards.
PLEX_CLAIM=
